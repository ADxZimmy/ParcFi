# ---- Local development (default) -------------------------------------------
# Run `anvil`, then `forge script script/DeployLocal.s.sol ...` (see contracts/README)
# and paste the two logged addresses:
NEXT_PUBLIC_NETWORK=anvil
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
# Demo role keys default to the six canonical anvil dev accounts — no need to set.

# ---- Arc Testnet ------------------------------------------------------------
# NEXT_PUBLIC_NETWORK=arc
# NEXT_PUBLIC_ESCROW_ADDRESS=   # from Circle Contracts deployment (or DeployArc.s.sol fallback)
# NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
# NEXT_PUBLIC_START_BLOCK=      # block number of the escrow deployment (bounds event queries)
# Six comma-separated FRESH burner keys (payer,attestor,resolver,carrier,terminal,forwarder).
# Testnet-only throwaways holding nothing but demo funds — never reuse real keys:
# NEXT_PUBLIC_DEMO_KEYS=

# ---- Circle (Phase 003 wallet integration; server-side only, never NEXT_PUBLIC) ----
# CIRCLE_API_KEY=
# CIRCLE_APP_ID=
